# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PRESET_SIGNING_KEY: Server-side HMAC-SHA256 secret for signing sensitivity configs.
# Never expose this key to client bundles.
PRESET_SIGNING_KEY="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"
